{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
